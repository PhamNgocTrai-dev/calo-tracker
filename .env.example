# Public application URL used to build the Supabase email-confirmation callback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public project values from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only HMAC secret for the fixed five-minute application session.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SESSION_SIGNING_SECRET=replace-with-a-strong-server-only-secret
